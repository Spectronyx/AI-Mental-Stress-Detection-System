# Environment variables for local development
# Copy this file to .env and fill in your values

# Django
DJANGO_SECRET_KEY=change-me-to-a-real-secret-key

# PostgreSQL (used in Docker; SQLite is used for local dev)
POSTGRES_DB=stressdb
POSTGRES_USER=stress_user
POSTGRES_PASSWORD=change-me-in-production

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ALLOW_ALL=true

# ML settings
ML_DEFAULT_MODEL=ensemble
ML_ALERT_THRESHOLD=4
ML_LLM_ENABLED=false

# Optional: set these to enable LLM empathetic responses
OPENAI_API_KEY=
GEMINI_API_KEY=

# Deployment
ALLOWED_HOSTS=localhost,127.0.0.1
